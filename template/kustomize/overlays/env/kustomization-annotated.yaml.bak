apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

# ─── 全局命名空间：所有资源统一注入此 namespace。所有从 base 继承来的资源都会被覆盖/填充成这个 namespace。───
namespace: projectNameEnv

# ─── 旧写法（已弃用）：Strategic Merge 补丁列表 ───
# 保留作为参考，已迁移到下方 patches 块
# patchesStrategicMerge:
#   - deployment.yaml
#   - ingress.yaml
#   - service.yaml
#   - configmap.yaml
#   - secret.yaml

# ─── 统一标签：注入到所有资源的 metadata.labels ───
commonLabels:
  app: serviceNameEnv                         # 应用名称，用于 selector 匹配
  app.kubernetes.io/name: projectNameEnv      # K8s 标准标签：服务名
  app.kubernetes.io/version: v1               # K8s 标准标签：应用版本

# ─── 基座：继承 base 目录的所有资源 ───
resources: # 旧字段 bases
  - ../../base                   # 加载 base/kustomization.yaml

# ─── 镜像替换：自动替换 Deployment 中的 image ───
images:
  - name: cd-harbor.yunwdh.cn/library/serviceNameEnv   # 匹配 base 中的镜像名前缀
    newName: imagesNameEnv                              # 替换为实际镜像路径
    newTag: imageTagNameEnv                             # 替换为构建号/版本号

# ─── 补丁列表（推荐写法） ───
patches:
  # Strategic Merge Patch：Kustomize 自动按 metadata.name 匹配目标资源。补丁YAML文件中里写了什么就覆盖什么，没写的保持 base 原值不变
  - path: service.yaml             # 覆盖 Service 端口
  - path: configmap.yaml           # 覆盖 ConfigMap 的 data
  - path: secret.yaml              # 覆盖 Secret 的镜像仓库凭证
  # JSON Patch：需显式指定 target
  - path: ingress-patch.yaml       # 替换 Ingress 的 host
    target:
      kind: Ingress                # 只作用于 Ingress 资源
